<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Logo -->
        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_game_button_primary"
            android:gravity="center"
            android:text="⚡"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Pokemon MDP"
            android:textColor="@color/game_gold"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Masuk dan lanjutkan petualanganmu"
            android:textColor="@color/game_text_on_dark"
            android:textSize="13sp" />

        <!-- Panel login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_game_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="TRAINER LOGIN"
                android:textColor="@color/game_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_game_input"
                android:hint="Username"
                android:padding="14dp"
                android:textColor="@color/game_text_dark"
                android:textColorHint="@color/game_text_muted"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_game_input"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/game_text_dark"
                android:textColorHint="@color/game_text_muted"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="MULAI PETUALANGAN"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:backgroundTint="@color/game_primary"
                app:cornerRadius="26dp"
                app:strokeColor="@color/game_border"
                app:strokeWidth="3dp" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="Belum punya akun? Register"
                android:textColor="@color/game_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
