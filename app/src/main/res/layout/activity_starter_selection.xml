<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Pilih Starter Pokemon Kamu"
            android:textColor="#0F2A4D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Pilihan ini cuma bisa dilakukan sekali, pilih dengan bijak!"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- ===== Bulbasaur ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_grass"
                android:orientation="vertical">

                <!-- Badge tipe -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#33FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="GRASS"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="#33FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="POISON"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Artwork gede -->
                <ImageView
                    android:id="@+id/imgBulbasaur"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- Overlay bawah: nama, HP, tombol -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bulbasaur"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP 45"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPickBulbasaur"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@android:color/white"
                    android:paddingHorizontal="24dp"
                    android:text="Pilih"
                    android:textAllCaps="false"
                    android:textColor="#0F2A4D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Charmander ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_fire"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="#33FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="FIRE"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgCharmander"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Charmander"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP 39"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPickCharmander"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@android:color/white"
                    android:paddingHorizontal="24dp"
                    android:text="Pilih"
                    android:textAllCaps="false"
                    android:textColor="#0F2A4D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Squirtle ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_water"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="#33FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="WATER"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgSquirtle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Squirtle"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP 44"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPickSquirtle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@android:color/white"
                    android:paddingHorizontal="24dp"
                    android:text="Pilih"
                    android:textAllCaps="false"
                    android:textColor="#0F2A4D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>