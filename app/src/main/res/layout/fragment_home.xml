<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="88dp">

            <!-- Greeting -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:paddingBottom="8dp"
                android:text="Halo, Trainer!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <!-- Starter Kamu -->
            <LinearLayout
                android:id="@+id/layoutStarterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgStarter"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Starter Kamu"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                    <TextView
                        android:id="@+id/tvStarterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bulbasaur"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvStarterLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 1"
                        android:textSize="13sp"
                        android:textColor="#757575" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#3F51B5"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Pokemon MDP"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tangkap, rawat, dan koleksi Pokemon favoritmu"
                    android:textSize="13sp"
                    android:textColor="#E8EAF6" />

            </LinearLayout>

            <!-- Section: Info Terbaru -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:text="Info Terbaru"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInfoTerbaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:clipToPadding="false"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmptyTerbaru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="20dp"
                android:text="Belum ada info terbaru"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:visibility="gone" />

            <!-- Section: Info Lainnya -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:text="Info Lainnya"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInfoLainnya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvEmptyLainnya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Belum ada info lainnya"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnOpenShop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="🛒 Shop" />

</FrameLayout>