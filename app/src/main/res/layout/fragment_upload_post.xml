<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Tambah Promo / Post"
            android:textColor="#0F2A4D"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="10dp"
            android:background="#F3F4F6"
            android:contentDescription="Preview gambar"
            android:scaleType="centerCrop"/>

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@android:color/white"
            android:text="Pilih Gambar"
            android:textAllCaps="false"
            android:textColor="#0F2A4D"
            app:cornerRadius="10dp"
            app:strokeColor="#0F2A4D"
            app:strokeWidth="1dp"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_border"
            android:hint="Judul (contoh: Charizard VMAX)"
            android:padding="14dp"/>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_border"
            android:gravity="top"
            android:hint="Deskripsi"
            android:minLines="3"
            android:padding="14dp"/>

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_border"
            android:hint="Harga (Rp)"
            android:inputType="numberDecimal"
            android:padding="14dp"/>

        <EditText
            android:id="@+id/etStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_border"
            android:hint="Stok"
            android:inputType="number"
            android:padding="14dp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_border"
            android:padding="10dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#0F2A4D"
            android:text="Simpan Post"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>