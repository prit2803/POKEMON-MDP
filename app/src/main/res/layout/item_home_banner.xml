<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="150dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <ImageView
        android:id="@+id/ivBannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#0F2A4D" />

    <!-- Ribbon (PROMO buat post, FEATURED buat gambar statis) -->
    <TextView
        android:id="@+id/tvBannerRibbon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_badge_red"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="PROMO"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Overlay gelap + info di bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B30F2A4D"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Promo"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvBannerPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rp0"
            android:textColor="#90CAF9"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.cardview.widget.CardView>