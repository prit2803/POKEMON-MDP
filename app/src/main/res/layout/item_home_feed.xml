<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_border"
    android:padding="12dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/ivFeedImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:background="#F3F4F6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFeedCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_navy"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="KATEGORI"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFeedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Judul Post"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvFeedDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Deskripsi singkat post"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvFeedPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rp0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F2A4D" />
    </LinearLayout>

</LinearLayout>