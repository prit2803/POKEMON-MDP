<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_border"
    android:layout_margin="6dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:paddingHorizontal="8dp">

    <!-- Foto bulat + badge lock -->
    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <ImageView
            android:id="@+id/imgPokemon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/bg_circle_light_gray"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_gallery" />

        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_navy"
            android:contentDescription="Terkunci"
            android:padding="4dp"
            android:src="@android:drawable/ic_lock_lock"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPokemonName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Pikachu"
        android:textColor="#111827"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPokemonLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill_navy"
        android:paddingHorizontal="12dp"
        android:paddingVertical="3dp"
        android:text="Lv. 1"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPokemonHp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="HP: 120"
        android:textColor="#6B7280"
        android:textSize="12sp" />

</LinearLayout>