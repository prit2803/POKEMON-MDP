<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - game style (dark). -->
    <style name="Base.Theme.Proyek_MDP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/game_primary</item>
        <item name="colorPrimaryVariant">@color/game_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/game_gold</item>
        <item name="colorOnSecondary">@color/game_text_dark</item>

        <item name="android:windowBackground">@color/game_bg_dark</item>
        <item name="android:statusBarColor">@color/game_navy_dark</item>
        <item name="android:navigationBarColor">@color/game_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
